{
  "name": "tranzfer-v2",
  "version": "0.0.0",
  "private": true,
  "description": "Reliable file transfer for creators and editors.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "build": "vp run -r build",
    "build:web": "vp run --filter @tranzfer/web build",
    "start": "vp run --filter @tranzfer/web start",
    "test": "vp run --filter @tranzfer/web test",
    "test:e2e": "vp run --filter @tranzfer/e2e test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "plan": "vp run --filter @tranzfer/infra plan",
    "deploy": "vp run --filter @tranzfer/infra deploy",
    "destroy": "vp run --filter @tranzfer/infra destroy",
    "prepare": "vp config && effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "effect": "4.0.0-rc.115",
    "eslint-plugin-solid": "0.18.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "0.15.6",
    "typescript": "7.0.2",
    "ultracite": "7.11.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.4.1"
}
