{
  "name": "tranzfer-v2",
  "version": "0.0.0",
  "private": true,
  "description": "Reliable file transfer for creators and editors.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "portless --no-tls",
    "dev:web": "pnpm --filter @tranzfer/web dev",
    "dev:api": "pnpm --filter @tranzfer/api dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm --filter @tranzfer/web start",
    "test": "pnpm --filter @tranzfer/web test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "prepare": "vp config"
  },
  "devDependencies": {
    "eslint-plugin-solid": "0.18.0",
    "oxlint": "1.82.0",
    "portless": "0.15.6",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.4.1"
}
