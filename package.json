{
  "name": "tranzfer-v2",
  "version": "0.0.0",
  "private": true,
  "description": "Reliable file transfer for creators and editors.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "build": "vp run -r build",
    "build:web": "vp run --filter @tranzfer/web build",
    "start": "vp run --filter @tranzfer/web start",
    "test": "vp run --filter @tranzfer/api --filter @tranzfer/web test && vp test run tools/oxlint/anti-slop/tranzfer",
    "test:e2e": "vp run --filter @tranzfer/e2e test",
    "test:gate": "vp run --filter @tranzfer/e2e gate",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "plan": "vp run --filter @tranzfer/infra plan",
    "deploy": "vp run --filter @tranzfer/infra deploy",
    "destroy": "vp run --filter @tranzfer/infra destroy",
    "prepare": "vp config && effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@effect/sql-d1": "catalog:",
    "@effect/sql-sqlite-do": "catalog:",
    "@effect/tsgo": "0.51.1",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.85.0",
    "effect": "catalog:",
    "eslint-plugin-solid": "0.18.1",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "portless": "0.15.7",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.4.1"
}
