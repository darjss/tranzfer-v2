# Better Auth
# Only the production stage (plan/deploy) needs this; dev stages mint their own.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Non-production staging login key; generate with: openssl rand -hex 32
TEST_LOGIN_KEY=

# Web origin the API worker trusts; cookies and OAuth callbacks live there
APP_URL=https://tranzfer.localhost
