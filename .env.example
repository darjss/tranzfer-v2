# Better Auth
# Only the production stage (plan/deploy) needs this; dev stages mint their own.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Non-production staging login key; generate with: openssl rand -hex 32
# Uncomment after generating; an empty value fails secret validation.
# TEST_LOGIN_KEY=

# Polar organization access token. Production uses the live organization
# (POLAR_ACCESS_TOKEN); every other stage uses the sandbox organization
# (POLAR_SANDBOX_ACCESS_TOKEN). Scopes: products, webhooks, checkouts,
# customers and customer sessions, read and write.
POLAR_SANDBOX_ACCESS_TOKEN=
POLAR_ACCESS_TOKEN=

# Web origin the API worker trusts; cookies and OAuth callbacks live there
APP_URL=https://tranzfer.localhost
