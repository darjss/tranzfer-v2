{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite-plus/client", "@cloudflare/workers-types"],

    // Paths
    "paths": {
      "styled-system/*": ["./styled-system/*"]
    },

    // Effect 4.0 still tags these unstable; we use them on purpose (#84).
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": ["effect/http", "effect/observability", "effect/rpc"]
      }
    ]
  }
}
