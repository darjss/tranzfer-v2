# Only tranzfer.app belongs in search results. Static pages skip the Worker,
# so staging and PR previews mark them here; App.tsx does the same for SSR.
https://:sub.tranzfer.app/*
  X-Robots-Tag: noindex

# Static pages skip the Worker; src/middleware.ts sets the same headers on
# everything the Worker serves.
/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' data: https://*.r2.cloudflarestorage.com; media-src 'self' blob: https://*.r2.cloudflarestorage.com; connect-src 'self' https://*.r2.cloudflarestorage.com; base-uri 'self'; form-action 'self'

# Build output under /assets carries a content hash in each filename, so a
# changed file gets a new URL and the old one can stay cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
