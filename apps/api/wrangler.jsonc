{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tranzfer-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  // Local wrangler simulation only. Live D1/R2/service bindings come from Alchemy.
  "d1_databases": [
    { "binding": "DB", "database_name": "tranzfer", "database_id": "local-tranzfer" },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tranzfer-files" }],
}
