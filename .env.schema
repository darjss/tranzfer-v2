# Tranzfer's environment. Names, types and sensitivity live here; values do
# not. Each developer keeps theirs in ~/.config/tranzfer/.env.local, encrypted
# with `varlock encrypt --file`, so worktrees need no copies. A checkout-only
# override goes in a gitignored .env.local next to this file. CI passes values
# as process env, which wins over both.
#
# Check what resolved, with secrets masked: `vp exec varlock load --agent`
#
# @defaultSensitive=true @defaultRequired=false
# @import(~/.config/tranzfer/.env.local, allowMissing=true)
# ---

# Web origin the API worker trusts; cookies, CORS and OAuth callbacks live there.
# The infra scripts set it per stage.
# @type=url @sensitive=false @required
APP_URL=https://tranzfer.localhost

# Account that hosts every stage
# @sensitive=false
CLOUDFLARE_ACCOUNT_ID=

# Alchemy's deploy token. Account-wide, so never paste it anywhere.
CLOUDFLARE_API_TOKEN=

# Only production needs it; other stages provision a stable Random secret.
# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Production needs both; other stages sign in with Google only when both are set.
# @sensitive=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Staging login key for non-production stages and e2e runs. Generate with
# `openssl rand -hex 32`.
# @type=string(minLength=32)
TEST_LOGIN_KEY=
